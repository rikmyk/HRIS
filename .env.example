# HRIS System Environment Configuration Baseline
# Copy this file to .env for local development

# Server Configuration
PORT=8080
ENVIRONMENT=development # development | staging | production
LOG_LEVEL=debug

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=hris_user
DB_PASSWORD=hris_secret_password
DB_NAME=hris_db
DB_SSLMODE=disable
DATABASE_URL=postgres://hris_user:hris_secret_password@localhost:5432/hris_db?sslmode=disable

# Redis Configuration (Cache & Asynq Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# MinIO Object Storage Configuration (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_password
MINIO_BUCKET_PHOTOS=hris-attendance-photos
MINIO_BUCKET_PAYSLIPS=hris-payslips-pdf
MINIO_USE_SSL=false

# Authentication & Security
JWT_SECRET=hris_jwt_super_secret_key_change_in_production_32bytes
JWT_ACCESS_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_DAYS=30

# System Defaults
GEOFENCE_RADIUS_DEFAULT_METERS=100.0
